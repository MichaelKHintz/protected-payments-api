# Copy to .env.okta (gitignored) and fill in. Used by scripts/get-token.sh.
OKTA_ISSUER=https://<tenant>.us.auth0.com
CHECKOUT_CLIENT_ID=<checkout-service client ID>
CHECKOUT_CLIENT_SECRET=<checkout-service client secret>
SUPPORT_CLIENT_ID=<support-portal client ID>
SUPPORT_CLIENT_SECRET=<support-portal client secret>
